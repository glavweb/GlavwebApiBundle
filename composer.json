{
    "name": "glavweb/api-bundle",
    "type": "symfony-bundle",
    "description": "CQRS/REST/OpenAPI helpers for Glavweb APIs",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrey Nilov",
            "email": "nilov@glavweb.ru",
            "homepage": "https://glavweb.ru"
        },
        {
            "name": "Glavweb Community",
            "homepage": "https://github.com/glavweb/GlavwebApiBundle/contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "glavweb/extra-bundle": "^1.0",
        "glavweb/datagrid-bundle": "^4.0",
        "glavweb/data-schema-bundle": "^3.0",
        "league/tactician-bundle": "^1.6",
        "nelmio/api-doc-bundle": "^5.0",
        "doctrine/orm": "^3.3",
        "symfony/framework-bundle": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/validator": "^8.0",
        "liip/imagine-bundle": "^2.13"
    },
    "suggest": {
        "glavweb/uploader-bundle": "Needed for make:api-controller media fields and OpenAPI of upload routes",
        "symfony/maker-bundle": "Required for make:api-controller"
    },
    "autoload": {
        "psr-4": {
            "Glavweb\\ApiBundle\\": "src/"
        }
    }
}
